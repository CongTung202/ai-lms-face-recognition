# ==============================================================================
# HỆ THỐNG BIẾN MÔI TRƯỜNG MẪU (LMS & AI FACE RECOGNITION)
# Sao chép tệp này thành .env và điền các khóa thực tế của bạn
# ==============================================================================

# 1. Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_online_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# 2. Cơ sở dữ liệu NoSQL MongoDB
MONGODB_URI=mongodb://localhost:27017/lms_nosql_db

# 3. Dịch vụ lưu trữ Cloudinary CDN
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY_NAME=Root
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=lms_datn/faces

# 4. Cổng thanh toán trực tuyến PayOS VietQR
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# 5. Dịch vụ AI Microservice (Python FastAPI)
AI_SERVICE_URL=http://localhost:8001
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
